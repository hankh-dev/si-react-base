# 빌드 시점 설정입니다. 여기 값은 빌드할 때 번들에 고정됩니다.
# 배포 후에 바꿔야 하는 값(API 주소 등)은 public/config.js 에 둡니다.

# 배포 경로. 하위 경로에 올릴 때는 /portal/ 처럼 지정합니다.
VITE_BASE_PATH=/

# 목 API(MSW) 포함 여부. 운영 빌드에서는 항상 false 입니다.
VITE_ENABLE_MOCK=false

# npm run dev:api 로 실제 백엔드에 붙을 때 /api 요청을 넘길 주소
VITE_DEV_PROXY_TARGET=http://localhost:8080
