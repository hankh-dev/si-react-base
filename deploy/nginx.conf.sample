# Nginx 설정 예시 — 정적 파일(dist) 제공 + API 리버스 프록시
#
# 전제: dist 폴더의 내용을 /usr/share/nginx/html 에 올리고,
#       config.js 는 환경에 맞는 파일(deploy/config.*.js)로 덮어쓴 상태.
# 하위 경로(/portal/)에 배포하는 경우는 맨 아래 주석을 참고하세요.

server {
    listen       80;
    server_name  _;

    root   /usr/share/nginx/html;
    index  index.html;

    # 서버 버전 노출 방지, 기본 보안 헤더 (보안 점검 단골 항목)
    server_tokens off;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # 1) 빌드 산출물: 파일 이름에 내용 해시가 들어 있어 오래 캐시해도 안전합니다.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # 2) 런타임 환경설정: 배포 후 값이 바뀔 수 있으므로 캐시하지 않습니다.
    location = /config.js {
        add_header Cache-Control "no-cache";
    }

    # 3) API: 같은 도메인의 /api 를 백엔드(WAS)로 넘깁니다. 화면과 API 가 같은 도메인이면 CORS 설정이 필요 없습니다.
    location /api/ {
        proxy_pass         http://127.0.0.1:8080;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    # 4) 그 외 모든 주소: 화면 주소(/system/users 등)로 직접 들어오거나 새로고침해도
    #    index.html 을 돌려줘야 합니다. 이 설정이 없으면 새로고침 시 404 가 납니다.
    #    index.html 은 새 배포를 바로 반영하도록 캐시하지 않습니다.
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }
}

# ----- 하위 경로(/portal/)에 배포하는 경우 -----
# 빌드:  .env 의 VITE_BASE_PATH=/portal/ 로 바꾼 뒤 npm run build
# 파일:  dist 내용을 /usr/share/nginx/html/portal/ 에 올림
# 설정:  위의 location 을 아래처럼 /portal/ 기준으로 바꿉니다.
#
#   location /portal/assets/   { expires 1y; add_header Cache-Control "public, immutable"; try_files $uri =404; }
#   location = /portal/config.js { add_header Cache-Control "no-cache"; }
#   location /portal/          { add_header Cache-Control "no-cache"; try_files $uri /portal/index.html; }
#
# API 주소도 하위 경로 아래에 둔다면 config.js 의 apiBaseUrl 을 '/portal/api' 로 맞춥니다.
