{
  "name": "si-react-base",
  "private": true,
  "version": "0.1.0",
  "description": "SI 업무 시스템(백오피스)용 React 베이스 템플릿",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:api": "vite --mode api",
    "build": "tsc -b && vite build",
    "build:mock": "tsc -b && vite build --mode mock",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "licenses": "node scripts/licenses.mjs",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run build"
  },
  "dependencies": {
    "@ag-grid-community/locale": "36.3.0",
    "@ant-design/icons": "6.3.4",
    "@hookform/resolvers": "7.0.6",
    "@tanstack/react-query": "5.107.1",
    "ag-grid-community": "36.3.0",
    "ag-grid-react": "36.3.0",
    "antd": "6.7.0",
    "axios": "1.21.1",
    "dayjs": "1.11.23",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.92.0",
    "react-router": "8.5.1",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.10",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.14.0",
    "jsdom": "31.0.0",
    "msw": "3.0.5",
    "prettier": "3.10.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "write-excel-file": "4.1.1"
  },
  "overrides": {
    "minimatch": "11.0.8"
  }
}
